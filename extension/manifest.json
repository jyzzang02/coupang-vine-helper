{
  "manifest_version": 3,
  "name": "체험단 상품 우선순위 도우미",
  "version": "0.8.1",
  "description": "쿠팡체험단 상품 추천: 품절 제외, 재고 비교, 자동 스크롤, 선택형 자동 새로고침, 회차별 상대가격 점수. 리뷰 목록 테스트 모드 추가. 자동 신청 없음.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://my.coupang.com/productreview/*"
      ],
      "js": [
        "scoring.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}