{
  "manifest_version": 3,
  "name": "체험단 상품 우선순위 도우미",
  "version": "0.8.7",
  "description": "체험단 추천 TOP10 (빨강·노랑·파랑), 독립 가중치 설정, 선택형 새로고침. 자동 신청 없음.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://my.coupang.com/productreview/*"
      ],
      "js": [
        "scoring.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
