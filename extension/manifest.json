{
  "manifest_version": 3,
  "name": "체험단 상품 우선순위 도우미",
  "version": "0.3.0",
  "description": "쿠팡체험단 상품 목록 페이지에서만 표시된 상품을 분석해 순위를 보여주는 보조 도구. 신청/주문 자동화 없음.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://my.coupang.com/productreview/*"
      ],
      "js": [
        "scoring.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
