{
  "manifest_version": 3,
  "name": "체험단 상품 우선순위 도우미",
  "version": "0.8.6",
  "description": "체험단 상품 추천 TOP 10, 자동 새로고침, 30초 위치 유예, 5만원 이하 지연 로딩 오프라인 테스트. 자동 신청 없음.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://my.coupang.com/productreview/*"
      ],
      "js": [
        "scoring.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
