{
  "manifest_version": 3,
  "name": "체험단 상품 우선순위 도우미",
  "version": "0.8.5",
  "description": "체험단·리뷰 상품 우선순위 TOP 10(1~3 빨강, 4~5 주황, 6~10 파랑), 위치 확인 후 30초 갱신 유예. CSV 저장·자동 신청 없음.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://my.coupang.com/productreview/*"
      ],
      "js": [
        "scoring.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
