{
  "manifest_version": 3,
  "name": "체험단 상품 우선순위 도우미",
  "version": "0.8.8",
  "description": "쿠팡체험단 상품 우선순위 TOP 10, 카테고리 클릭 선택 및 가중치 편집, 선택형 자동 새로고침. 자동 신청 없음.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://my.coupang.com/productreview/*"
      ],
      "js": [
        "scoring.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
