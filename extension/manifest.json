{
  "manifest_version": 3,
  "name": "체험단 상품 우선순위 도우미",
  "version": "0.7.0",
  "description": "쿠팡체험단 상품 추천: 품절 제외, 재고 변화 비교, 자동 스크롤, 사진 기반 오프라인 시뮬레이션. 자동 새로고침·주문 없음.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://my.coupang.com/productreview/*"
      ],
      "js": [
        "scoring.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}