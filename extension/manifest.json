{
  "manifest_version": 3,
  "name": "체험단 상품 우선순위 도우미",
  "version": "0.6.0",
  "description": "쿠팡체험단 상품 우선순위 보조도구: 화면 내 스크롤·실시간 추천·내장 오프라인 테스트. 신청 기능 없음.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://my.coupang.com/productreview/*"
      ],
      "js": [
        "scoring.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
