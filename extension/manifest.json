{
  "manifest_version": 3,
  "name": "체험단 상품 우선순위 도우미",
  "version": "0.8.9",
  "description": "쿠팡체험단 상품 분석: TOP10, 사이즈·휴대폰·워치 호환성 필터, 아기·여성 전용 상품 제외, 재고 감소 테스트. 자동 신청 없음.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://my.coupang.com/productreview/*"
      ],
      "js": [
        "scoring.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
